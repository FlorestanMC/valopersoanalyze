# --- HenrikDev (API Valorant tierce, NON officielle) ---
# API non affiliée à Riot Games. Clé GRATUITE à récupérer sur le Discord HenrikDev :
#   https://discord.gg/henrikdev  (salon de génération de clé)
HENRIK_API_KEY=HDEV-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Ton Riot ID complet, forme Pseudo#TAG
RIOT_ID=MonPseudo#EUW

# Région : na | eu | ap | kr | latam | br
REGION=eu

# File à analyser : competitive | unrated | spikerush | deathmatch | all
QUEUE=competitive

# Nombre de parties à analyser
COUNT=10

# --- Anthropic (API Claude) ---
# Clé sur https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Modèle : claude-sonnet-5 (équilibré) | claude-opus-4-8 (analyse + poussée) | claude-haiku-4-5-20251001 (le moins cher)
ANTHROPIC_MODEL=claude-sonnet-5

# --- DeepSeek (analyse d'équipe, onglet Team) — FACULTATIF ---
# Clé sur https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat

# --- Hébergement en ligne (voir DEPLOY.md) — FACULTATIF en local ---
# Mot de passe d'accès au site (auth HTTP basique). Vide en local = pas de protection.
APP_PASSWORD=
# Dossier de données persistant (volume). Défaut = dossier du projet.
# VALO_DATA_DIR=/data
# Base Postgres (sinon SQLite dans VALO_DATA_DIR/valo.db). Idéal PaaS sans volume.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
